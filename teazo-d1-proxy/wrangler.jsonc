{
  // TEAZO D1 proxy Worker.
  //
  // The Next.js app is hosted on VERCEL and has no Cloudflare bindings.
  // This Worker is the only thing that binds D1 and R2, and it exists because
  // D1 is not reachable from outside a Worker — Cloudflare's own docs: "to
  // access a D1 database outside of a Worker project, you need to create an
  // API using a Worker".
  //
  // migrations_dir points back into the Next.js app on purpose: the schema is
  // the app's contract, so it lives next to the app. Wrangler accepts a path
  // outside its own project directory.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teazo-d1-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Hourly is plenty: a file's bytes are only reaped 24 hours after it is
  // deleted, which is the window for undoing a mistake.
  "triggers": { "crons": ["0 * * * *"] },

  // The R2 binding does not expose its own bucket name at runtime (there is no
  // env.MEDIA.name), and the sweeper needs it to refuse cross-bucket deletes.
  //
  // The two R2_ limits are this deployment's share of R2's free allowance, which
  // belongs to the whole ACCOUNT. Production and preview share it, so their
  // values must add up to no more than 9.6 GB (9600000000) and 30000 a day.
  // Production gets 9.5 GB of it. The Worker cannot see the other deployment's
  // values, so nothing checks the sum for you. See BILLING HARD STOPS in
  // src/index.ts for why the total is 9.6 GB and not 10.
  "vars": {
    "MEDIA_BUCKET_NAME": "teazo-media",
    "R2_STORAGE_CAP_BYTES": "9500000000",
    "R2_CLASS_A_DAILY_BUDGET": "25000"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teazo-db",
      // Created on the team Cloudflare account. Not a secret, and the
      // Worker cannot deploy from a fresh clone without it.
      "database_id": "de4f8bf8-4a40-4397-9468-588951d7275c",
      "migrations_dir": "../teazo-site/migrations"
    }
  ],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "teazo-media" }],

  "env": {
    "preview": {
      // vars are not inherited, so every one is repeated here.
      "vars": {
        "MEDIA_BUCKET_NAME": "teazo-media-preview",
        "R2_STORAGE_CAP_BYTES": "100000000",
        "R2_CLASS_A_DAILY_BUDGET": "5000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "teazo-db-preview",
          "database_id": "acfbbe45-5ee1-4a23-a365-b71badfdf50a",
          "migrations_dir": "../teazo-site/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "teazo-media-preview" }]
    }
  }
}
