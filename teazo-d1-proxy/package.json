{
  "name": "teazo-d1-proxy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:cron": "wrangler dev --test-scheduled",
    "tail": "wrangler tail teazo-d1-proxy",
    "typegen": "wrangler types --env-interface Env worker-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply teazo-db --local",
    "db:seed:dev": "wrangler d1 execute teazo-db --local --file dev-seed.sql",
    "db:backup": "wrangler d1 export teazo-db --remote --output ./backup.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "typescript": "^5.9.3",
    "wrangler": "^4"
  }
}
